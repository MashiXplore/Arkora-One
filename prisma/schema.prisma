generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @unique @db.VarChar(50)
  description     String?          @db.Text
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  rolePermissions RolePermission[]
  users           User[]

  @@map("roles")
}

model Module {
  id              Int              @id @default(autoincrement())
  name            String           @unique @db.VarChar(100)
  slug            String           @unique @db.VarChar(100)
  description     String?          @db.Text
  createdAt       DateTime         @default(now()) @map("created_at")
  rolePermissions RolePermission[]

  @@map("modules")
}

model RolePermission {
  id        Int     @id @default(autoincrement())
  roleId    Int     @map("role_id")
  moduleId  Int     @map("module_id")
  canCreate Boolean @default(false) @map("can_create")
  canRead   Boolean @default(true) @map("can_read")
  canUpdate Boolean @default(false) @map("can_update")
  canDelete Boolean @default(false) @map("can_delete")
  module    Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, moduleId])
  @@index([moduleId], map: "role_permissions_module_id_fkey")
  @@map("role_permissions")
}

model User {
  id                   Int       @id @default(autoincrement())
  name                 String    @db.VarChar(150)
  username             String    @unique @db.VarChar(80)
  email                String    @unique @db.VarChar(150)
  passwordHash         String    @map("password_hash") @db.Text
  roleId               Int       @map("role_id")
  isActive             Boolean   @default(true) @map("is_active")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  informes             Informe[]
  ordenesRecepcionadas Orden[]   @relation("OrdenRecepcionista")
  ordenesAsignadas     Orden[]   @relation("OrdenTecnico")
  role                 Role      @relation(fields: [roleId], references: [id])

  @@index([roleId], map: "users_role_id_fkey")
  @@map("users")
}

model Sucursal {
  id        Int       @id @default(autoincrement())
  nombre    String    @unique @db.VarChar(150)
  direccion String?   @db.Text
  telefono  String?   @db.VarChar(50)
  estado    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  agencias  Agencia[]

  @@map("sucursales")
}

model Agencia {
  id               Int           @id @default(autoincrement())
  nombre           String        @unique @db.VarChar(150)
  direccion        String?       @db.Text
  telefono         String?       @db.VarChar(50)
  especificaciones String?       @db.LongText
  estado           Boolean       @default(true)
  sucursalId       Int?          @map("sucursal_id")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  sucursal         Sucursal?     @relation(fields: [sucursalId], references: [id])
  funcionarios     Funcionario[]
  informes         Informe[]

  @@index([sucursalId], map: "agencias_sucursal_id_fkey")
  @@map("agencias")
}

model Cargo {
  id               Int           @id @default(autoincrement())
  nombre           String        @unique @db.VarChar(150)
  descripcion      String?       @db.Text
  especificaciones String?       @db.LongText
  estado           Boolean       @default(true)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  funcionarios     Funcionario[]

  @@map("cargos")
}

model Funcionario {
  id                Int      @id @default(autoincrement())
  nombre            String   @db.VarChar(150)
  correo            String?  @db.VarChar(150)
  telefono          String?  @db.VarChar(50)
  departamento_area String?  @map("departamento_area") @db.VarChar(100)
  estado            Boolean  @default(true)
  cargoId           Int      @map("cargo_id")
  agenciaId         Int      @map("agencia_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  equipos           Equipo[]
  agencia           Agencia  @relation(fields: [agenciaId], references: [id])
  cargo             Cargo    @relation(fields: [cargoId], references: [id])
  ordenes           Orden[]

  @@index([agenciaId], map: "funcionarios_agencia_id_fkey")
  @@index([cargoId], map: "funcionarios_cargo_id_fkey")
  @@map("funcionarios")
}

model Marca {
  id           Int          @id @default(autoincrement())
  nombre       String       @unique @db.VarChar(100)
  slug         String       @unique @db.VarChar(100)
  imagen       String?      @db.Text
  estado       Boolean      @default(true)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  equipos      Equipo[]
  modelos      Modelo[]
  tipo_equipos TipoEquipo[]

  @@map("marcas")
}

model TipoEquipo {
  id        Int      @id @default(autoincrement())
  nombre    String   @db.VarChar(100)
  slug      String   @db.VarChar(100)
  estado    Boolean  @default(true)
  marcaId   Int?     @map("marca_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  equipos   Equipo[]
  modelos   Modelo[]
  marca     Marca?   @relation(fields: [marcaId], references: [id])

  @@index([marcaId], map: "tipos_equipo_marca_id_fkey")
  @@map("tipos_equipo")
}

model Modelo {
  id               Int         @id @default(autoincrement())
  nombre           String      @db.VarChar(100)
  slug             String?     @db.VarChar(100)
  especificaciones String?     @db.LongText
  estado           Boolean     @default(true)
  marcaId          Int         @map("marca_id")
  tipo_equipo_id   Int?        @map("tipo_equipo_id")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  equipos          Equipo[]
  marca            Marca       @relation(fields: [marcaId], references: [id])
  tipo_equipo      TipoEquipo? @relation(fields: [tipo_equipo_id], references: [id])

  @@index([marcaId], map: "modelos_marca_id_fkey")
  @@index([tipo_equipo_id], map: "modelos_tipo_equipo_id_fkey")
  @@map("modelos")
}

model Equipo {
  id               Int             @id @default(autoincrement())
  numero_etiqueta  String          @unique @map("numero_etiqueta") @db.VarChar(100)
  numero_serie     String?         @map("numero_serie") @db.VarChar(100)
  fecha_ingreso    DateTime?       @map("fecha_ingreso") @db.Date
  observaciones    String?         @db.Text
  imagen           String?         @db.Text
  especificaciones String?         @db.LongText
  estado_operativo EstadoOperativo @default(operativo) @map("estado_operativo")
  tipo_equipo_id   Int             @map("tipo_equipo_id")
  marca_id         Int             @map("marca_id")
  modelo_id        Int             @map("modelo_id")
  funcionario_id   Int?            @map("funcionario_id")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  funcionario      Funcionario?    @relation(fields: [funcionario_id], references: [id])
  marca            Marca           @relation(fields: [marca_id], references: [id])
  modelo           Modelo          @relation(fields: [modelo_id], references: [id])
  tipo_equipo      TipoEquipo      @relation(fields: [tipo_equipo_id], references: [id])
  ordenes          Orden[]

  @@index([funcionario_id], map: "equipos_funcionario_id_fkey")
  @@index([marca_id], map: "equipos_marca_id_fkey")
  @@index([modelo_id], map: "equipos_modelo_id_fkey")
  @@index([tipo_equipo_id], map: "equipos_tipo_equipo_id_fkey")
  @@map("equipos")
}

model Orden {
  id                     Int          @id @default(autoincrement())
  numero_orden           String       @unique @map("numero_orden") @db.VarChar(30)
  fecha                  DateTime     @default(now())
  estado                 EstadoOrden  @default(creado)
  tipo_servicio          TipoServicio @default(reparacion) @map("tipo_servicio")
  prioridad              Prioridad    @default(media)
  diagnostico_inicial    String?      @map("diagnostico_inicial") @db.Text
  fecha_estimada_entrega DateTime?    @map("fecha_estimada_entrega") @db.Date
  especificaciones       String?      @db.LongText
  id_recepcion           Int          @map("id_recepcion")
  id_tecnico             Int?         @map("id_tecnico")
  id_equipo              Int          @map("id_equipo")
  id_funcionario         Int          @map("id_funcionario")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")
  informe                Informe?
  equipo                 Equipo       @relation(fields: [id_equipo], references: [id])
  funcionario            Funcionario  @relation(fields: [id_funcionario], references: [id])
  recepcionista          User         @relation("OrdenRecepcionista", fields: [id_recepcion], references: [id])
  tecnico                User?        @relation("OrdenTecnico", fields: [id_tecnico], references: [id])

  @@index([id_equipo], map: "ordenes_id_equipo_fkey")
  @@index([id_funcionario], map: "ordenes_id_funcionario_fkey")
  @@index([id_recepcion], map: "ordenes_id_recepcion_fkey")
  @@index([id_tecnico], map: "ordenes_id_tecnico_fkey")
  @@map("ordenes")
}

model Informe {
  id                Int      @id @default(autoincrement())
  tipo_informe      String   @map("tipo_informe") @db.VarChar(100)
  titulo            String   @db.VarChar(200)
  descripcion       String?  @db.Text
  diagnostico_final String?  @map("diagnostico_final") @db.Text
  solucion_aplicada String?  @map("solucion_aplicada") @db.Text
  fecha             DateTime @default(now()) @db.Date
  archivo_ruta      String?  @map("archivo_ruta") @db.VarChar(255)
  user_id           Int      @map("user_id")
  orden_id          Int      @unique @map("orden_id")
  agencia_id        Int?     @map("agencia_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  agencia           Agencia? @relation(fields: [agencia_id], references: [id])
  orden             Orden    @relation(fields: [orden_id], references: [id])
  tecnico           User     @relation(fields: [user_id], references: [id])

  @@index([agencia_id], map: "informes_agencia_id_fkey")
  @@index([user_id], map: "informes_user_id_fkey")
  @@map("informes")
}

enum EstadoOperativo {
  operativo
  en_mantenimiento
  de_baja
  en_desuso
}

enum EstadoOrden {
  creado
  en_proceso
  finalizado
  entregado
  cancelado
}

enum TipoServicio {
  reparacion
  mantenimiento_preventivo
  mantenimiento_correctivo
  diagnostico
  instalacion
}

enum Prioridad {
  baja
  media
  alta
  urgente
}
